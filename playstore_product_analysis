    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# Set clean visual style\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "plt.rcParams[\"figure.figsize\"] = (10, 5)\n",
    "\n",
    "# 1. Load datasets\n",
    "apps = pd.read_csv(\"googleplaystore.csv\")\n",
    "reviews = pd.read_csv(\"googleplaystore_user_reviews.csv\")\n",
    "\n",
    "print(f\"Raw Apps Shape: {apps.shape}\")\n",
    "print(f\"Raw Reviews Shape: {reviews.shape}\")\n",
    "\n",
    "# 2. Data Cleaning (Handling real-world Play Store anomalies)\n",
    "# Remove the notorious shifted row where Category == '1.9'\n",
    "apps = apps[apps[\"Category\"] != \"1.9\"].copy()\n",
    "\n",
    "# Deduplicate apps by keeping the entry with the highest Review count\n",
    "apps[\"Reviews\"] = pd.to_numeric(apps[\"Reviews\"], errors=\"coerce\")\n",
    "apps = apps.sort_values(\"Reviews\", ascending=False).drop_duplicates(subset=[\"App\"], keep=\"first\")\n",
    "\n",
    "# Clean Installs ('10,000+' -> 10000) and Price ('$4.99' -> 4.99)\n",
    "apps[\"Installs_Clean\"] = (\n",
    "    apps[\"Installs\"].str.replace(\"+\", \"\", regex=False)\n",
    "    .str.replace(\",\", \"\", regex=False)\n",
    ")\n",
    "apps[\"Installs_Clean\"] = pd.to_numeric(apps[\"Installs_Clean\"], errors=\"coerce\")\n",
    "\n",
    "apps[\"Price_Clean\"] = apps[\"Price\"].str.replace(\"$\", \"\", regex=False)\n",
    "apps[\"Price_Clean\"] = pd.to_numeric(apps[\"Price_Clean\"], errors=\"coerce\")\n",
    "\n",
    "# Clean Size ('19M' -> 19.0 MB, '500k' -> 0.5 MB, 'Varies with device' -> NaN)\n",
    "def clean_size(val):\n",
    "    if pd.isna(val) or val == \"Varies with device\":\n",
    "        return np.nan\n",
    "    if \"M\" in val:\n",
    "        return float(val.replace(\"M\", \"\"))\n",
    "    if \"k\" in val:\n",
    "        return float(val.replace(\"k\", \"\")) / 1024\n",
    "    return np.nan\n",
    "\n",
    "apps[\"Size_MB\"] = apps[\"Size\"].apply(clean_size)\n",
    "\n",
    "# Clean Reviews dataset (drop rows with missing Translated_Review)\n",
    "reviews_clean = reviews.dropna(subset=[\"Translated_Review\", \"Sentiment\"]).copy()\n",
    "\n",
    "print(\"\\n--- CLEANED DATASET SUMMARY ---\")\n",
    "print(f\"Unique Apps Analyzed: {len(apps):,}\")\n",
    "print(f\"Valid User Reviews Analyzed: {len(reviews_clean):,}\")\n",
    "print(f\"Overall Average Rating: {apps['Rating'].mean():.2f} / 5.0\")\n",
    "print(f\"Free vs Paid Split:\\n{apps['Type'].value_counts(normalize=True).mul(100).round(1)}\")"
   ]
  },
