    "# --- CELL 2: PRODUCT BOTTLENECK ANALYSIS & VISUALIZATIONS ---\n",
    "\n",
    "# 1. Category Saturation vs. Quality Opportunity Matrix (Top 12 Categories by Installs)\n",
    "cat_summary = (\n",
    "    apps.groupby(\"Category\")\n",
    "    .agg(\n",
    "        App_Count=(\"App\", \"count\"),\n",
    "        Total_Installs=(\"Installs_Clean\", \"sum\"),\n",
    "        Avg_Rating=(\"Rating\", \"mean\"),\n",
    "        Median_Reviews=(\"Reviews\", \"median\")\n",
    "    )\n",
    "    .sort_values(\"Total_Installs\", ascending=False)\n",
    "    .head(12)\n",
    ")\n",
    "cat_summary[\"Installs_Billions\"] = (cat_summary[\"Total_Installs\"] / 1e9).round(2)\n",
    "cat_summary[\"Avg_Rating\"] = cat_summary[\"Avg_Rating\"].round(2)\n",
    "\n",
    "print(\"--- TOP 12 CATEGORIES BY INSTALL VOLUME ---\")\n",
    "print(cat_summary[[\"App_Count\", \"Installs_Billions\", \"Avg_Rating\"]])\n",
    "\n",
    "# 2. App Size Bloat Friction Analysis (Does heavier app size hurt user ratings?)\n",
    "apps[\"Size_Tier\"] = pd.cut(\n",
    "    apps[\"Size_MB\"],\n",
    "    bins=[0, 10, 30, 60, 100],\n",
    "    labels=[\"Lightweight (<10MB)\", \"Standard (10-30MB)\", \"Heavy (30-60MB)\", \"Bloated (60-100MB)\"]\n",
    ")\n",
    "size_impact = apps.groupby(\"Size_Tier\", observed=False).agg(\n",
    "    Apps=(\"App\", \"count\"),\n",
    "    Avg_Rating=(\"Rating\", \"mean\"),\n",
    "    Avg_Installs=(\"Installs_Clean\", \"mean\")\n",
    ").round(2)\n",
    "print(\"\\n--- APP SIZE VS. RATING & ADOPTION ---\")\n",
    "print(size_impact)\n",
    "\n",
    "# 3. Sentiment & Friction Driver Analysis (Merging App Metadata with 37k+ User Reviews)\n",
    "merged = pd.merge(reviews_clean, apps[[\"App\", \"Category\", \"Rating\", \"Installs_Clean\", \"Type\"]], on=\"App\", how=\"inner\")\n",
    "sentiment_split = merged[\"Sentiment\"].value_counts(normalize=True).mul(100).round(1)\n",
    "print(\"\\n--- USER REVIEW SENTIMENT DISTRIBUTION ---\")\n",
    "print(sentiment_split)\n",
    "\n",
    "# Extract top friction keywords in Negative Reviews\n",
    "neg_reviews = merged[merged[\"Sentiment\"] == \"Negative\"][\"Translated_Review\"].str.lower()\n",
    "friction_keywords = {\n",
    "    \"Ads / Popups\": neg_reviews.str.contains(r\"\\bad\\b|\\bads\\b|advert|popup\").mean() * 100,\n",
    "    \"Crashes / Bugs / Freeze\": neg_reviews.str.contains(r\"crash|bug|freeze|error|fix|broken\").mean() * 100,\n",
    "    \"Update Regression\": neg_reviews.str.contains(r\"update|version|worst|ruined\").mean() * 100,\n",
    "    \"Paywall / Subscription\": neg_reviews.str.contains(r\"pay|money|subscription|expensive|buy\").mean() * 100,\n",
    "    \"Battery / Storage / Slow\": neg_reviews.str.contains(r\"slow|lag|battery|storage|space|heavy\").mean() * 100\n",
    "}\n",
    "friction_df = pd.Series(friction_keywords).sort_values(ascending=True).round(1)\n",
    "print(\"\\n--- % OF NEGATIVE REVIEWS CITING PRODUCT FRICTION ---\")\n",
    "print(friction_df)\n",
    "\n",
    "# --- SAVE CHART 1: Category Opportunity Matrix ---\n",
    "fig, ax = plt.subplots(figsize=(10, 5.5))\n",
    "colors = [\"#D93025\" if r < 4.15 else \"#1A73E8\" for r in cat_summary[\"Avg_Rating\"]]\n",
    "bars = ax.barh(cat_summary.index[::-1], cat_summary[\"Installs_Billions\"][::-1], color=colors[::-1])\n",
    "ax.set_title(\"Google Play Store: Top 12 Categories by Installs (Red = Below-Avg Rating < 4.15)\", fontsize=12, fontweight=\"bold\")\n",
    "ax.set_xlabel(\"Total Cumulative Installs (Billions)\")\n",
    "for bar, rating in zip(bars, cat_summary[\"Avg_Rating\"][::-1]):\n",
    "    ax.text(bar.get_width() + 0.2, bar.get_y() + bar.get_height()/2, f\"{bar.get_width():.1f}B  (★ {rating})\", va=\"center\", fontsize=9)\n",
    "ax.set_xlim(0, cat_summary[\"Installs_Billions\"].max() * 1.25)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"fig1_category_matrix.png\", dpi=300)\n",
    "plt.show()\n",
    "\n",
    "# --- SAVE CHART 2: Root-Cause Friction in Negative User Reviews ---\n",
    "fig, ax = plt.subplots(figsize=(9, 4.5))\n",
    "bars2 = ax.barh(friction_df.index, friction_df.values, color=\"#F29900\")\n",
    "ax.set_title(\"Root-Cause Friction Drivers Across Negative Play Store Reviews (%)\", fontsize=12, fontweight=\"bold\")\n",
    "ax.set_xlabel(\"Share of Negative Reviews Mentioning Friction (%)\")\n",
    "for bar in bars2:\n",
    "    ax.text(bar.get_width() + 0.4, bar.get_y() + bar.get_height()/2, f\"{bar.get_width():.1f}%\", va=\"center\", fontsize=10, fontweight=\"bold\")\n",
    "ax.set_xlim(0, friction_df.max() * 1.2)\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"fig2_sentiment_drivers.png\", dpi=300)\n",
    "plt.show()"
   ]
